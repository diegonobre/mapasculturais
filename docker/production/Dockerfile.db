FROM postgis/postgis:14-master

# Demo: o banco inicia com o dump de desenvolvimento.
# - volume vazio: carregado pelo initdb (20_load-dump.sh)
# - volume já inicializado sem schema: carregado pelo db-entrypoint.sh
COPY dev/db/dump.sql /dump.sql
COPY docker/production/load-dump.sh /docker-entrypoint-initdb.d/20_load-dump.sh
COPY docker/production/db-entrypoint.sh /usr/local/bin/db-entrypoint.sh
RUN chmod +x /docker-entrypoint-initdb.d/20_load-dump.sh /usr/local/bin/db-entrypoint.sh

ENTRYPOINT ["db-entrypoint.sh"]
CMD ["postgres"]
